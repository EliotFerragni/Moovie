<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VideoMetadataFiller.App.ViewModels"
             x:Class="VideoMetadataFiller.App.Views.PreviewPane"
             x:DataType="vm:PreviewPaneViewModel">

  <Grid RowDefinitions="Auto,*">

    <!-- Header: poster, what is selected, and the per-file language -->
    <Border Grid.Row="0" Padding="14,12" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource PanelBorder}">
      <Grid ColumnDefinitions="Auto,*">

        <Border Width="62" Height="93" CornerRadius="5" ClipToBounds="True"
                Background="{DynamicResource PosterPlaceholder}" Margin="0,0,12,0"
                VerticalAlignment="Top" IsVisible="{Binding IsSingleSelection}">
          <Image Source="{Binding Poster}" Stretch="UniformToFill" />
        </Border>

        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Text="{Binding HeaderTitle}" Classes="h2" TextWrapping="Wrap" />
          <TextBlock Text="{Binding HeaderSubtitle}" Classes="subtle" TextWrapping="Wrap" />

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0"
                      IsVisible="{Binding HasSelection}">
            <TextBlock Text="Language" Classes="subtle" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Languages}"
                      SelectedItem="{Binding SelectedLanguage}"
                      IsEnabled="{Binding IsSingleSelection}"
                      MinWidth="180" />
            <Button Content="Refetch" Command="{Binding RefetchCommand}"
                    ToolTip.Tip="Fetch this file's metadata again, keeping anything you have edited by hand." />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Nothing selected -->
    <TextBlock Grid.Row="1" Classes="subtle" Margin="32"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               TextAlignment="Center" TextWrapping="Wrap"
               IsVisible="{Binding !HasSelection}"
               Text="Select a file to review its metadata.&#x0a;&#x0a;Select several to edit the fields they have in common." />

    <ScrollViewer Grid.Row="1" IsVisible="{Binding HasSelection}" Padding="14,12">
      <StackPanel Spacing="2">

        <!-- Why this file needs attention -->
        <Border Classes="notice" IsVisible="{Binding HasNotice}">
          <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" />
        </Border>

        <!-- Candidate chooser: resolves an ambiguous match -->
        <StackPanel IsVisible="{Binding HasCandidates}" Margin="0,0,0,12">
          <TextBlock Text="CHOOSE A TITLE" Classes="sectionLabel" />
          <ItemsControl ItemsSource="{Binding Candidates}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CandidateViewModel">
                <Border Classes="candidate">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Width="46" Height="69" CornerRadius="4" ClipToBounds="True"
                            Background="{DynamicResource PosterPlaceholder}"
                            Margin="0,0,10,0" VerticalAlignment="Top">
                      <Image Source="{Binding Poster}" Stretch="UniformToFill" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="2">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Year}" Classes="subtle" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Text="{Binding OriginalTitle}" Classes="subtle" FontStyle="Italic"
                                 IsVisible="{Binding HasOriginalTitle}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Overview}" Classes="subtle" TextWrapping="Wrap"
                                 MaxLines="3" TextTrimming="CharacterEllipsis" />
                      <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,3,0,0">
                        <TextBlock Text="{Binding Kind}" Classes="subtle" FontSize="11" />
                        <TextBlock Text="{Binding ConfidenceText}" Classes="subtle" FontSize="11" />
                        <TextBlock Text="{Binding TmdbReference}" Classes="subtle" FontSize="11" />
                      </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="2" Content="Use this" VerticalAlignment="Center"
                            Margin="10,0,0,0"
                            Command="{Binding $parent[ItemsControl].((vm:PreviewPaneViewModel)DataContext).ChooseCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Manual search, for names the parser could not make sense of -->
        <Expander Header="Search TMDB by hand" Margin="0,0,0,12"
                  IsVisible="{Binding IsSingleSelection}">
          <StackPanel Spacing="8" Margin="0,6,0,0">
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding SearchText}" Watermark="Title to search for" />
              <Button Grid.Column="1" Content="Search" Margin="6,0,0,0"
                      Command="{Binding SearchCommand}" IsEnabled="{Binding !IsSearching}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding TmdbIdText}" Watermark="…or paste a TMDB id" />
              <Button Grid.Column="1" Content="Use id" Margin="6,0,0,0"
                      Command="{Binding ApplyTmdbIdCommand}" IsEnabled="{Binding !IsSearching}" />
            </Grid>
            <TextBlock Text="{Binding SearchMessage}" Classes="subtle" TextWrapping="Wrap" />
          </StackPanel>
        </Expander>

        <!-- Movie / TV toggle -->
        <TextBlock Text="TYPE" Classes="sectionLabel" />
        <ListBox SelectedIndex="{Binding KindIndex}" Margin="0,0,0,14"
                 HorizontalAlignment="Left">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBoxItem Content="Movie" />
          <ListBoxItem Content="TV episode" />
        </ListBox>

        <!-- The metadata form. One template drives every field; see FieldEditor. -->
        <TextBlock Text="METADATA" Classes="sectionLabel" />
        <ItemsControl ItemsSource="{Binding Fields}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FieldEditor">
              <StackPanel IsVisible="{Binding IsVisible}" Margin="0,0,0,11">
                <Grid ColumnDefinitions="Auto,Auto,*">
                  <TextBlock Text="{Binding Label}" Classes="fieldLabel" />

                  <!-- A dot marks a value you typed rather than one TMDB supplied. -->
                  <Ellipse Grid.Column="1" Width="5" Height="5" Margin="5,0,0,4"
                           VerticalAlignment="Center"
                           Fill="{DynamicResource InfoColor}"
                           IsVisible="{Binding IsUserEdited}"
                           ToolTip.Tip="You edited this field. A refetch will keep it." />

                  <TextBlock Grid.Column="2" Text="filled in from English" Classes="subtle"
                             FontSize="11" HorizontalAlignment="Right"
                             IsVisible="{Binding IsFallback}"
                             ToolTip.Tip="TMDB has no translation for this field in the chosen language." />
                </Grid>

                <TextBox Text="{Binding Value}" Watermark="{Binding Watermark}"
                         IsReadOnly="{Binding !IsEditable}"
                         IsVisible="{Binding !IsMultiline}" />

                <TextBox Text="{Binding Value}" Watermark="{Binding Watermark}"
                         IsReadOnly="{Binding !IsEditable}"
                         IsVisible="{Binding IsMultiline}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="96" />

                <TextBlock Text="{Binding Hint}" Classes="subtle" FontSize="11"
                           Margin="2,3,0,0" TextWrapping="Wrap"
                           IsVisible="{Binding HasHint}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
