<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Moovie.App.Views"
        xmlns:vm="using:Moovie.App.ViewModels"
        x:Class="Moovie.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Moovie"
        Icon="avares://Moovie/Assets/Icon/app-256.png"
        Width="1280" Height="820"
        MinWidth="900" MinHeight="560"
        Background="{DynamicResource AppBackground}">

  <!-- The window is only a frame. Everything in it lives in MainView, which the web host puts on
       a RemoteServer instead, so both ways of running show the very same tree. -->
  <views:MainView x:Name="View" />
</Window>
