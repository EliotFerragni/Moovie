<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Moovie.App.Views"
        xmlns:vm="using:Moovie.App.ViewModels"
        x:Class="Moovie.App.Views.AboutWindow"
        x:DataType="vm:AboutViewModel"
        Title="{Binding WindowTitle}"
        Icon="avares://Moovie/Assets/Icon/app-256.png"
        Width="440" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">

  <views:AboutView x:Name="View" />
</Window>
