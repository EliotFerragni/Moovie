<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Moovie.App.Localization"
        xmlns:views="using:Moovie.App.Views"
        xmlns:vm="using:Moovie.App.ViewModels"
        x:Class="Moovie.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{loc:T settings.windowTitle}"
        Icon="avares://Moovie/Assets/Icon/app-256.png"
        Width="840" Height="780"
        MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">

  <views:SettingsView x:Name="View" />
</Window>
