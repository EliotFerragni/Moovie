<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Moovie.App.Localization"
        xmlns:vm="using:Moovie.App.ViewModels"
        x:Class="Moovie.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Icon="avares://Moovie/Assets/Icon/app-256.png"
        Width="840" Height="780"
        MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">

  <Grid RowDefinitions="*,Auto">

    <ScrollViewer Padding="20,16,28,16">
      <StackPanel Spacing="20">

        <!-- TMDB access -->
        <StackPanel Spacing="6">
          <TextBlock Text="{loc:T settings.tmdbSection}" Classes="sectionLabel" />
          <TextBlock Classes="subtle" TextWrapping="Wrap"
                     Text="{loc:T settings.tmdbBlurb}" />
          <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
            <TextBox Text="{Binding ApiKey}" PasswordChar="•"
                     Watermark="{loc:T settings.apiKeyWatermark}" />
            <Button Grid.Column="1" Content="{loc:T settings.testKey}" Margin="6,0,0,0"
                    Command="{Binding TestKeyCommand}" IsEnabled="{Binding !IsTestingKey}" />
          </Grid>
          <TextBlock Text="{Binding KeyStatus}" Classes="subtle" TextWrapping="Wrap"
                     IsVisible="{Binding HasKeyStatus}" />

          <TextBlock Text="{loc:T settings.metadataLanguage}" Classes="fieldLabel" Margin="0,10,0,3" />
          <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}"
                    HorizontalAlignment="Left" MinWidth="240" />
          <TextBlock Classes="subtle" FontSize="11" TextWrapping="Wrap" Margin="2,3,0,0"
                     Text="{loc:T settings.metadataLanguageHint}" />
          <TextBlock Text="{loc:T settings.appLanguage}" Classes="fieldLabel" Margin="0,10,0,3" />
          <ComboBox ItemsSource="{Binding AppLanguages}" SelectedItem="{Binding AppLanguage}"
                    HorizontalAlignment="Left" MinWidth="240" />
          <TextBlock Classes="subtle" FontSize="11" TextWrapping="Wrap" Margin="2,3,0,0"
                     Text="{loc:T settings.appLanguageHint}" />
        </StackPanel>

        <!-- Artwork and safety -->
        <StackPanel Spacing="6">
          <TextBlock Text="{loc:T settings.artworkSection}" Classes="sectionLabel" />
          <TextBlock Text="{loc:T settings.artworkSize}" Classes="fieldLabel" />
          <ComboBox ItemsSource="{Binding ArtworkSizes}" SelectedItem="{Binding ArtworkSize}"
                    HorizontalAlignment="Left" MinWidth="160" />
          <TextBlock Classes="subtle" FontSize="11" TextWrapping="Wrap" Margin="2,3,0,0"
                     Text="{loc:T settings.artworkSizeHint}" />

          <TextBlock Text="{loc:T settings.tvArtwork}" Classes="fieldLabel" Margin="0,10,0,3" />
          <ComboBox ItemsSource="{Binding TvArtworkKinds}" SelectedItem="{Binding TvArtwork}"
                    HorizontalAlignment="Left" MinWidth="200" />

          <TextBlock Text="{loc:T settings.movieArtwork}" Classes="fieldLabel" Margin="0,10,0,3" />
          <ComboBox ItemsSource="{Binding MovieArtworkKinds}" SelectedItem="{Binding MovieArtwork}"
                    HorizontalAlignment="Left" MinWidth="200" />
          <TextBlock Classes="subtle" FontSize="11" TextWrapping="Wrap" Margin="2,3,0,0"
                     Text="{loc:T settings.artworkKindHint}" />
          <CheckBox Content="{loc:T settings.backup}"
                    IsChecked="{Binding CreateBackup}" Margin="0,6,0,0" />
        </StackPanel>

        <!-- Renaming -->
        <StackPanel Spacing="6">
          <TextBlock Text="{loc:T settings.renamingSection}" Classes="sectionLabel" />
          <CheckBox Content="{loc:T settings.renameOnApply}" IsChecked="{Binding RenameEnabled}" />

          <TextBlock Text="{loc:T settings.separator}" Classes="fieldLabel" Margin="0,8,0,3" />
          <ComboBox ItemsSource="{Binding Separators}" SelectedItem="{Binding Separator}"
                    HorizontalAlignment="Left" MinWidth="330" />

          <TextBlock Text="{loc:T settings.omitResolution}" Classes="fieldLabel" Margin="0,8,0,3" />
          <ComboBox ItemsSource="{Binding ResolutionFloors}"
                    SelectedItem="{Binding OmitResolutionAtOrBelow}"
                    HorizontalAlignment="Left" MinWidth="330" />
          <TextBlock Classes="subtle" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"
                     Text="{loc:T settings.omitResolutionHint}" />
        </StackPanel>

        <!-- The two template editors -->
        <ContentControl Content="{Binding MovieTemplate}" ContentTemplate="{StaticResource TemplateEditor}" />
        <ContentControl Content="{Binding TvTemplate}" ContentTemplate="{StaticResource TemplateEditor}" />

        <TextBlock Text="{Binding SettingsFileNote}" Classes="subtle" FontSize="11"
                   TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" Classes="toolbar" BorderThickness="0,1,0,0" Padding="18,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="{loc:T settings.cancel}" Click="OnCancel" IsCancel="True" />
        <Button Content="{loc:T settings.save}" Click="OnSave" Classes="accent" IsDefault="True"
                IsEnabled="{Binding CanSave}" />
      </StackPanel>
    </Border>
  </Grid>

  <Window.Resources>
    <!--
      One editor, used for both the movie and the TV template. The token palette and the digit
      spinners exist so the everyday adjustments never need knowledge of the syntax.
    -->
    <DataTemplate x:Key="TemplateEditor" x:DataType="vm:RenameTemplateEditorViewModel">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding Title}" Classes="h2" />
          <Button Grid.Column="1" Content="{loc:T settings.resetDefault}" Classes="chip" FontFamily="{x:Null}"
                  Command="{Binding ResetToDefaultCommand}" />
        </Grid>

        <TextBox Text="{Binding Template}" Classes="mono" Name="TemplateBox"
                 AttachedToVisualTree="OnTemplateBoxAttached" />

        <TextBlock Text="{Binding Errors}" Foreground="{DynamicResource ErrorColor}"
                   FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasErrors}" />

        <!-- Digit spinners: the common "how many digits for the season" case -->
        <StackPanel Orientation="Horizontal" Spacing="14" IsVisible="{Binding ShowsDigitSpinners}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{loc:T settings.seasonDigits}" Classes="subtle" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding DigitOptions}" SelectedItem="{Binding SeasonDigits}"
                      MinWidth="64" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{loc:T settings.episodeDigits}" Classes="subtle" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding DigitOptions}" SelectedItem="{Binding EpisodeDigits}"
                      MinWidth="64" />
          </StackPanel>
        </StackPanel>

        <TextBlock Text="{loc:T settings.clickToInsert}" Classes="subtle" FontSize="11" Margin="0,4,0,0" />
        <ItemsControl ItemsSource="{Binding Tokens}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TokenChip">
              <Button Classes="chip" Content="{Binding Caption}"
                      Command="{Binding $parent[ItemsControl].((vm:RenameTemplateEditorViewModel)DataContext).InsertTokenCommand}"
                      CommandParameter="{Binding}">
                <!--
                  Every form the token takes, against what each would produce for the sample
                  above. Monospace because the two columns are padded into the string rather
                  than laid out here.
                -->
                <ToolTip.Tip>
                  <StackPanel Spacing="6" MaxWidth="460">
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Forms}" Classes="mono" FontSize="11" />
                  </StackPanel>
                </ToolTip.Tip>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{loc:T settings.preview}" Classes="fieldLabel" Margin="0,4,0,0" />
        <Border Classes="preview">
          <StackPanel Spacing="3">
            <TextBlock Text="{Binding Preview}" Classes="mono" FontSize="12"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding ThresholdPreview}" Classes="mono subtle" FontSize="12"
                       TextWrapping="Wrap" IsVisible="{Binding HasThresholdPreview}" />
          </StackPanel>
        </Border>

        <TextBlock Classes="subtle" FontSize="11" TextWrapping="Wrap"
                   Text="{loc:T settings.templateHelp}" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>
</Window>
