<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Moovie.App</RootNamespace>
    <AssemblyName>Moovie</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- Windows reads this out of the executable itself; every other platform is served
         by the .icns in the macOS bundle or by the window icon below. -->
    <ApplicationIcon>Assets/Icon/app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- .axaml is picked up automatically; an image has to be named to be embedded. -->
    <AvaloniaResource Include="Assets/Icon/app-256.png" />

    <!-- The page the web mode serves. Embedded rather than copied so the single-file build stays one file. -->
    <EmbeddedResource Include="Web/WebClientPage.html" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <!-- Web mode draws with Skia into a frame buffer instead of onto a window, which is what
         the headless platform provides. Both ship with Avalonia itself; neither pulls in a
         browser engine or a second UI stack. -->
    <PackageReference Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Diagnostics" Version="$(AvaloniaVersion)" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Moovie.Core\Moovie.Core.csproj" />
  </ItemGroup>

</Project>
